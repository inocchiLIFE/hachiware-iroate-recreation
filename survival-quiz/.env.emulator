NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_PROJECT_ID=demo-survival-quiz
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
ADMIN_PASSWORD=admin
