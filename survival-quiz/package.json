{
  "name": "survival-quiz",
  "version": "1.0.0",
  "private": true,
  "description": "150人規模のイベント向け 2択サバイバルクイズ (Next.js + Firebase Firestore)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --only firestore --project demo-survival-quiz",
    "dev:emu": "firebase emulators:exec --only firestore --project demo-survival-quiz --ui \"next dev\"",
    "loadtest": "node scripts/load-test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.36.0",
    "typescript": "5.9"
  }
}
