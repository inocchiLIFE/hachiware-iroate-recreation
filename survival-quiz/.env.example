# ===== ブラウザ用 Firebase 設定（Firebase コンソール > プロジェクトの設定 > マイアプリ）=====
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== サーバー用 Firebase Admin（サービスアカウントの秘密鍵 JSON から転記）=====
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# 改行は \n のままで OK（ダブルクォートで囲む）
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===== 管理画面 =====
# /admin のログインパスワード（十分に長いものを）
ADMIN_PASSWORD=
# セッション Cookie の署名鍵（任意。未設定なら ADMIN_PASSWORD から生成）
ADMIN_SESSION_SECRET=

# ===== 任意 =====
# スクリーンの QR コードに載せる参加 URL（未設定ならスクリーンを開いているドメインの "/"）
NEXT_PUBLIC_JOIN_URL=

# ===== ローカル開発でエミュレーターを使う場合のみ（本番では空にする）=====
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
